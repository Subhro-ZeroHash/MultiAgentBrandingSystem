{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalDependencies": [".env", "tsconfig.base.json"],
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_BASE_URL",
    "LLM_PROVIDER",
    "LLM_MODEL_*",
    "GOOGLE_API_KEY",
    "GOOGLE_API_BASE_URL",
    "FAL_KEY",
    "OPENAI_API_KEY",
    "PERPLEXITY_API_KEY",
    "TAVILY_API_KEY",
    "SERPAPI_KEY",
    "WEB_SEARCH_PROVIDER",
    "LTX_API_KEY",
    "LTX_BASE_URL",
    "VIDEO_PROVIDER_PRIMARY",
    "VIDEO_MODEL_*",
    "VIDEO_ENDCARD_FONT",
    "VIDEO_ENDCARD_FONT_BOLD",
    "GEO_*",
    "S3_*",
    "R2_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "clean": {
      "cache": false
    }
  }
}
