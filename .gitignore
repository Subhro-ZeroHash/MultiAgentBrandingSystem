# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
.next/
out/
*.tsbuildinfo

# turbo
.turbo/

# env
# `.env.*` rather than only `.env.local`/`.env.*.local`: an ad-hoc backup made
# before editing a key (".env.bak-before-gemini") matched none of the narrower
# rules, so a real credential file sat one `git add -A` away from being pushed.
# Anything derived from .env is a secret unless it is explicitly an example.
.env
.env.*
!.env.example
!.env.production.example

# logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# test / coverage
coverage/
.nyc_output/

# editor / os
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# local scratch
tmp/
.scratch/

# local GEO testing tooling — not part of the product, never committed
/geo-test-ui/
/dev-geo.mjs

# generated assets (never commit user/brand media)
uploads/
assets/generated/
