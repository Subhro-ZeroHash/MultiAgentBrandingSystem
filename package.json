{
  "name": "brand-marketing-multi-agent-system",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,css}\"",
    "db:generate": "pnpm --filter @bmas/db db:generate",
    "db:migrate": "pnpm --filter @bmas/db db:migrate",
    "db:seed": "pnpm --filter @bmas/db db:seed",
    "db:studio": "pnpm --filter @bmas/db db:studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prettier": "^3.9.5",
    "rimraf": "^6.1.3",
    "turbo": "^2.10.5",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10"
  }
}
