# Copy to `.env` and fill in. Never commit `.env`.

NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Infrastructure (matches docker-compose.yml)
# ---------------------------------------------------------------------------
# Ports are intentionally non-default (see docker-compose.yml) so the containers
# don't collide with a locally-installed Postgres/Redis.
DATABASE_URL=postgres://bmas:bmas@localhost:5433/bmas
REDIS_URL=redis://localhost:6380

# S3-compatible object storage. Local default points at the MinIO container;
# swap for Cloudflare R2 / AWS S3 in deployed environments.
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_BUCKET=bmas-assets
S3_ACCESS_KEY_ID=bmas
S3_SECRET_ACCESS_KEY=bmas-secret
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/bmas-assets

# ---------------------------------------------------------------------------
# Ports
# ---------------------------------------------------------------------------
CONTENT_API_PORT=4000
GEO_API_PORT=4100
WEB_PORT=3000
NEXT_PUBLIC_CONTENT_API_URL=http://localhost:4000
NEXT_PUBLIC_GEO_API_URL=http://localhost:4100

# ---------------------------------------------------------------------------
# LLM providers
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Local-only override of the Anthropic API host. Leave empty everywhere except
# local development and CI, where it can point at a mock so the adapter's real
# request/response handling is exercised without credentials or spend.
ANTHROPIC_BASE_URL=

# Which provider serves text, JSON, and vision QA: anthropic | gemini | ollama.
# `gemini` runs the whole content pipeline on GOOGLE_API_KEY alone.
# `ollama` runs a local server (development only; requires running Ollama locally).
# Defaults to anthropic when unset.
LLM_PROVIDER=anthropic

# Local Ollama server (development only; use when cloud API keys aren't available).
# Run `ollama serve` locally, then uncomment below to use Ollama instead of cloud APIs:
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4:e4b

# Model roles. Defaults are set in packages/ai; override per-environment here.
# These ids are provider-specific: they MUST match LLM_PROVIDER above, or the
# call reaches the wrong API and 404s. Leave them empty to take the defaults
# that packages/ai already picks for the selected provider.
# GEO's analyser is an `orchestrator`-role call, so running it on a Google key
# means LLM_PROVIDER=gemini plus, on a free key, an LLM_MODEL_ORCHESTRATOR that
# the key can actually reach.
# Orchestration / reasoning-heavy steps.
LLM_MODEL_ORCHESTRATOR=
# High-volume, latency-sensitive steps (copy generation fan-out).
LLM_MODEL_VOLUME=
# Vision QA / judgement calls.
LLM_MODEL_QA=

# ---------------------------------------------------------------------------
# Image generation (content-generation system)
# ---------------------------------------------------------------------------
# Google AI Studio key. Serves the Gemini image family, and also text/JSON/
# vision when LLM_PROVIDER=gemini.
GOOGLE_API_KEY=
# Local-only override of the Gemini API host, same purpose as ANTHROPIC_BASE_URL.
GOOGLE_API_BASE_URL=
# gemini | fal | stub. `stub` draws watermarked placeholders locally instead of
# calling a provider — use it for local development, CI, and demos so runs cost
# nothing and work without credentials. Never set it in a deployed environment.
IMAGE_PROVIDER_PRIMARY=gemini
IMAGE_PROVIDER_EDIT=fal
IMAGE_MODEL_GEMINI=gemini-3-pro-image-preview
# Artificial per-image delay for the stub adapter, ms. Set a value like 1500 to
# watch the UI's per-stage progress behave as it would against a real provider.
IMAGE_STUB_LATENCY_MS=

# fal.ai — Flux Kontext edits + failover.
FAL_KEY=
IMAGE_MODEL_FAL_EDIT=fal-ai/flux-pro/kontext

# ---------------------------------------------------------------------------
# Answer engines (GEO system)
# ---------------------------------------------------------------------------
# Each engine is optional; probes skip engines with no credentials configured.
OPENAI_API_KEY=
PERPLEXITY_API_KEY=
# Gemini probes reuse GOOGLE_API_KEY above.
# Grounded calls on the 3.x line are paid-tier only (429, limit 0, on a free
# key); 2.5-flash grounds fine. Raise this once billing is enabled.
GEO_MODEL_GEMINI=gemini-2.5-flash
GEO_ENGINES_ENABLED=chatgpt,perplexity,gemini,claude

# Scheduling. Probe cadence is per prompt (tracked_prompts.schedule, a cron
# expression); these govern the roll-up that turns runs into snapshots.
GEO_ROLLUP_CRON=0 7 * * *
GEO_ROLLUP_WINDOW_DAYS=7
# How often the worker reconciles prompt schedulers against the database, in ms.
# This is the lag between creating a prompt and it starting to probe.
GEO_SCHEDULER_SYNC_MS=60000

# ---------------------------------------------------------------------------
# Web search (Trend Research Agent)
# ---------------------------------------------------------------------------
# Real-time search grounding what the trend agent finds — an LLM's training
# data cannot report this week's news, so this is not optional the way an
# image-provider fallback is. Get a key at https://tavily.com; the free tier
# (1,000 searches/month) is enough for development.
TAVILY_API_KEY=
# `stub` returns fixture results with no network call and no cost — useful for
# local dev or CI without a Tavily key. Leave as `tavily` once TAVILY_API_KEY
# is set. Only affects webSearch() (single-provider callers like the AI
# research prompt box) — the signal pipeline below uses every configured
# provider regardless of this setting.
WEB_SEARCH_PROVIDER=tavily

# Second, independent search provider for the signal pipeline (trend +
# intelligence research). Optional — leave blank and the pipeline runs on
# Tavily alone, same as before this existed. A topic both providers surface
# independently is treated as stronger evidence than either alone. Get a key
# at https://serpapi.com.
SERPAPI_KEY=

# ---------------------------------------------------------------------------
# Auth (placeholder until the auth provider is chosen)
# ---------------------------------------------------------------------------
AUTH_SECRET=replace-me-with-32-bytes-of-random

# Stand-in for the authenticated user until auth lands. Matches the row created
# by `pnpm db:seed`; remove once requests carry a real identity.
DEV_OWNER_ID=dev-user

# Where content-worker reaches content-api's HTTP API. Used only by the
# scheduled-post publish job, which posts through content-api's existing
# /social/post endpoint instead of duplicating the Instagram publish logic.
CONTENT_API_URL=http://localhost:4000/api

# ---------------------------------------------------------------------------
# Social Media Integration
# ---------------------------------------------------------------------------
# Instagram API with Instagram Login: the account signs in with Instagram and
# no Facebook Page is involved. These are the *Instagram* app credentials, not
# the Facebook app's — developers.facebook.com → your app → Instagram →
# "API setup with Instagram login" → Instagram app ID / Instagram app secret.
# The account being connected must be a Business or Creator account.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must be exactly 32 bytes (256 bits) for AES-256-GCM. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Must be HTTPS and match the dashboard byte-for-byte — Instagram Login rejects
# plain http, localhost included, so local testing needs a tunnel (e.g. cloudflared).
INSTAGRAM_OAUTH_REDIRECT_URI=
# Public origin Meta can reach to download images when publishing. Instagram
# fetches the image from its own servers, so the LAN address in
# S3_PUBLIC_ENDPOINT is not enough — use the same Cloudflare tunnel as the OAuth callback.
PUBLIC_ASSET_BASE_URL=


# Extra rounds of image generation allowed when the QA readback fails (FR-3.5).
# This is the cost ceiling for auto-regeneration: worst-case images per job is
# variantCount x (1 + this). 0 disables it. Max 3.
# Set to 0 to minimize image-gen spend while no provider key is live.
QA_REGENERATION_ROUNDS=0
